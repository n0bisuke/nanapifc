# コピーして .dev.env にリネームして使う(絶対にコミットしない)

# フットサル(LaBOLA)のみのカレンダー
GOOGLE_CALENDAR_ID=
# 調整さんの出欠人数も入れた版のカレンダー(任意。空なら同期しない)
GOOGLE_CALENDAR_ATTENDANCE_ID=
# 調整さんの出欠表URL(上のカレンダーを使う場合は必須。カンマ区切りで複数可)
CHOUSEISAN_URL=

# 同期対象店舗(LaBOLA店舗ID:表示名[:キーワード[:会場]] をカンマ区切り)
# 会場は「/」区切りの部分一致(タイトルに含まれるものだけ)。未指定時は↓の3店舗
LABOLA_SHOPS=1047:蒲田個サル:チーム,3007:カルチョ::すみだフットサルアリーナ/代々木競技場,3443:楽天地

SYNC_DAYS=31
# FETCH_KEYWORD は旧設定(蒲田のキーワード)。LABOLA_SHOPS 未指定時にのみ使われる
FETCH_KEYWORD=チーム